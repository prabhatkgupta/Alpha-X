# ================================================================
# Alpha-X Configuration Template
# ================================================================
# Copy this file to .env and fill in your actual values
# Command: cp .env.example .env
# ================================================================

# ----------------------------------------------------------------
# Google Form & Sheets Configuration
# ----------------------------------------------------------------
# Your Google Form URL (for filling daily data)
GOOGLE_FORM_URL=https://forms.gle/YOUR_FORM_ID_HERE

# Your Google Sheet URL (where form responses are stored)
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID_HERE/edit

# Google Sheet ID (extract from the URL above)
# Example: If URL is https://docs.google.com/spreadsheets/d/ABC123XYZ/edit
# Then GOOGLE_SHEET_ID=ABC123XYZ
GOOGLE_SHEET_ID=your_google_sheet_id_here

# ----------------------------------------------------------------
# Notifications: whatsapp (Twilio) or telegram (Bot API)
# ----------------------------------------------------------------
# whatsapp = default; use Twilio vars below
# telegram = set TELEGRAM_* below; Twilio vars not required
NOTIFY_CHANNEL=whatsapp

# ----------------------------------------------------------------
# Telegram Bot (only if NOTIFY_CHANNEL=telegram)
# ----------------------------------------------------------------
# Create a bot with @BotFather, then message your bot once and get chat_id:
#   curl "https://api.telegram.org/bot<TOKEN>/getUpdates"
# (Telegram does not use your phone number in the API — use chat_id.)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Only if you still see SSL errors behind a corporate proxy (disables TLS verify):
# TELEGRAM_INSECURE_SSL=1

# ----------------------------------------------------------------
# Twilio WhatsApp Configuration (only if NOTIFY_CHANNEL=whatsapp)
# ----------------------------------------------------------------
# Get these from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Twilio WhatsApp Sandbox Number (for testing)
# Default sandbox number: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Your WhatsApp Number (must include country code)
# Format: whatsapp:+[country_code][phone_number]
# Example: whatsapp:+918789653411
YOUR_WHATSAPP_NUMBER=whatsapp:+your_country_code_and_number

# ----------------------------------------------------------------
# Setup Instructions
# ----------------------------------------------------------------
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values in .env
# 3. Never commit .env to git (it's in .gitignore)
# 4. See SETUP_GUIDE.md for detailed setup instructions
# ----------------------------------------------------------------
